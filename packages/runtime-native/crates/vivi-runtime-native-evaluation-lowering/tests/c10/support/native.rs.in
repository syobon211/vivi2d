pub use error::{EvaluationLoweringError, EvaluationLoweringErrorKind};
pub use model::EvaluationLoweringFoundationV1;
std::thread_local!{
    static C9_DENIAL:std::cell::Cell<Option<reservation::ReservationDenialKeyV1>>=const{std::cell::Cell::new(None)};
    static C10_CASE:std::cell::Cell<Option<u32>>=const{std::cell::Cell::new(None)};
}
pub fn lower_evaluation_foundation_v1(generation:u64,candidate:vivi_runtime_native_preactivation::ValidatedEvaluationPayloadV1,plan:vivi_runtime_native_preactivation::EvaluationTexturePlanV1)->Result<EvaluationLoweringFoundationV1,EvaluationLoweringError>{
    if let Some(denial)=C9_DENIAL.with(|d|d.take()){
        let correlated=vivi_runtime_native_preactivation::correlate_evaluation_activation_v1(generation,candidate,plan).map_err(EvaluationLoweringError::from_correlation)?;
        lower::lower_correlated_with_test_denial(correlated,denial)
    }else{
        let mut foundation=lower::lower_evaluation_foundation_v1(generation,candidate,plan)?;
        if let Some(index)=C10_CASE.with(|c|c.take()){
            injections::before_initial(&mut foundation.reservation_plan,literal_cases::CASES[index as usize].injections);
        }
        Ok(foundation)
    }
}
