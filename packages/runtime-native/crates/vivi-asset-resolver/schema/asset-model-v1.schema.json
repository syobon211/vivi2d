{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivi2d.com/spec/asset-model-v1.schema.json",
  "title": "Vivi2D Asset Model v1",
  "$comment": "Machine-readable freeze artifact adopted by Spec Freeze Amendment 1. Cross-field hashes, manifest sums, JCS addresses, UTF-8 media-type byte length, ASCII-control rejection, and case-insensitive digest comparison require semantic validation.",
  "x-vivi-status": "approved-amendment-1",
  "oneOf": [
    { "$ref": "#/$defs/ViviAssetRefV1" },
    { "$ref": "#/$defs/AssetChunkManifestV1" }
  ],
  "$defs": {
    "NonNegativeSafeIntegerV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveSafeIntegerV1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Sha256HexV1": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "$comment": "Wire input accepts either hex case. Producers emit lowercase; consumers normalize for equality and lookup. JCS hashes the received manifest values unchanged."
    },
    "MediaTypeV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "$comment": "JSON Schema length is in Unicode code points. Stage-2 semantic validation additionally requires 1..255 UTF-8 bytes and rejects ASCII control characters U+0000..U+001F and U+007F."
    },
    "ViviAssetRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectAddress",
        "storageKind",
        "contentSha256",
        "mediaType",
        "sizeBytes"
      ],
      "properties": {
        "objectAddress": { "$ref": "#/$defs/Sha256HexV1" },
        "storageKind": {
          "type": "string",
          "enum": ["blob", "chunk_manifest"]
        },
        "contentSha256": { "$ref": "#/$defs/Sha256HexV1" },
        "mediaType": { "$ref": "#/$defs/MediaTypeV1" },
        "sizeBytes": { "$ref": "#/$defs/NonNegativeSafeIntegerV1" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "storageKind": { "const": "blob" } },
            "required": ["storageKind"]
          },
          "then": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              }
            },
            "$comment": "Semantic invariant: objectAddress must equal contentSha256 for blob."
          },
          "else": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 16777217,
                "maximum": 68719476736
              }
            }
          }
        }
      ]
    },
    "EmbeddableBlobAssetRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectAddress",
        "storageKind",
        "contentSha256",
        "mediaType",
        "sizeBytes"
      ],
      "properties": {
        "objectAddress": { "$ref": "#/$defs/Sha256HexV1" },
        "storageKind": { "const": "blob" },
        "contentSha256": { "$ref": "#/$defs/Sha256HexV1" },
        "mediaType": { "$ref": "#/$defs/MediaTypeV1" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      },
      "$comment": "Semantic invariant: objectAddress must equal contentSha256."
    },
    "PngAssetRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectAddress",
        "storageKind",
        "contentSha256",
        "mediaType",
        "sizeBytes"
      ],
      "properties": {
        "objectAddress": { "$ref": "#/$defs/Sha256HexV1" },
        "storageKind": {
          "type": "string",
          "enum": ["blob", "chunk_manifest"]
        },
        "contentSha256": { "$ref": "#/$defs/Sha256HexV1" },
        "mediaType": { "const": "image/png" },
        "sizeBytes": { "$ref": "#/$defs/NonNegativeSafeIntegerV1" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "storageKind": { "const": "blob" } },
            "required": ["storageKind"]
          },
          "then": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              }
            }
          },
          "else": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 16777217,
                "maximum": 68719476736
              }
            }
          }
        }
      ]
    },
    "AssetChunkV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/Sha256HexV1" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "AssetChunkManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mediaType",
        "contentSha256",
        "sizeBytes",
        "chunkSizeBytes",
        "chunks"
      ],
      "properties": {
        "schema": { "const": "vivi2d.assetChunkManifest.v1" },
        "mediaType": { "$ref": "#/$defs/MediaTypeV1" },
        "contentSha256": { "$ref": "#/$defs/Sha256HexV1" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 16777217,
          "maximum": 68719476736
        },
        "chunkSizeBytes": { "const": 8388608 },
        "chunks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/AssetChunkV1" },
          "$comment": "Semantic invariants: every non-final chunk is exactly 8388608 bytes, the final chunk is 1..8388608 bytes, sizeBytes is the sum, and contentSha256 hashes the concatenated bytes. Stage-2 validation rejects a canonical JCS manifest larger than 1048576 bytes before durable acceptance."
        }
      }
    }
  }
}
